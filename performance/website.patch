@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Copy the harness's generated performance reports into content/performance/.
+
+    python3 tools/sync_performance.py /path/to/harness-checkout
+
+For every system in the harness's performance/systems.csv that has a
+performance/summary_<ID>.md:
+  <id>/perf_<ID>.md                -> performance/<ID>/<id>.md
+  performance/summary_<ID>.md      -> performance/<ID>/index.md
+  performance/method_<ID>.md       -> performance/<ID>/method.md
+plus performance/symmetric-survey.md -> performance/symmetric-survey.md and a
+generated performance/index.md listing the systems. Relative links between
+these pages are rewritten for the site layout; the directory is replaced.
+"""
+import csv
+import posixpath
+import re
+import shutil
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DEST = ROOT / "content" / "performance"
+LINK_RE = re.compile(r"\]\(([^)\s]+)\)")
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit("usage: python3 tools/sync_performance.py /path/to/harness-checkout")
+    src = Path(sys.argv[1]).resolve()
+    reg = src / "performance" / "systems.csv"
+    if not reg.is_file():
+        sys.exit(f"sync-performance: {src} has no performance/systems.csv")
+    with reg.open(encoding="utf-8") as f:
+        systems = [r for r in csv.DictReader((l for l in f if not l.startswith("#")), delimiter=";")
+                   if (src / "performance" / f"summary_{r['ID']}.md").is_file()]
+    if not systems:
+        sys.exit("sync-performance: no performance/summary_<ID>.md found")
+
+    # harness path -> site path (both relative to their roots)
+    site_of = {"performance/symmetric-survey.md": "performance/symmetric-survey.md"}
+    for r in systems:
+        sid = r["ID"]
+        site_of[f"performance/summary_{sid}.md"] = f"performance/{sid}/index.md"
+        site_of[f"performance/method_{sid}.md"] = f"performance/{sid}/method.md"
+        for page in sorted(src.glob(f"*-[0-9][0-9]/perf_{sid}.md")):
+            cid = page.parent.name
+            site_of[f"{cid}/perf_{sid}.md"] = f"performance/{sid}/{cid}.md"
+
+    def rewrite(text, src_rel, dst_rel):
+        def repl(m):
+            target = m.group(1)
+            if re.match(r"^[a-z][a-z0-9+.-]*:", target) or target.startswith("#"):
+                return m.group(0)
+            path, _, frag = target.partition("#")
+            resolved = posixpath.normpath(posixpath.join(posixpath.dirname(src_rel), path))
+            if resolved not in site_of:
+                return m.group(0)
+            rel = posixpath.relpath(site_of[resolved], posixpath.dirname(dst_rel))
+            return f"]({rel}{'#' + frag if frag else ''})"
+        return LINK_RE.sub(repl, text)
+
+    shutil.rmtree(DEST, ignore_errors=True)
+    for src_rel, dst_rel in site_of.items():
+        text = (src / src_rel).read_text(encoding="utf-8")
+        out = ROOT / "content" / dst_rel
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(f"<!-- synchronized from harness: {src_rel} -->\n" + rewrite(text, src_rel, dst_rel),
+                       encoding="utf-8")
+    index = ["# Performance", "",
+             "Independent measurements of the NGCC Round 1 implementations, per test system. "
+             "Each system page lists cycles per operation for every harness-built candidate and "
+             "the share of each operation spent in the ICCS placeholder hash functions.", "",
+             "| system | architecture | machine |", "|---|---|---|"]
+    for r in systems:
+        index.append(f"| [{r['ID']}]({r['ID']}/index.md) | {r['Arch']} | {r['Description']} |")
+    index += ["", "The [symmetric cryptography survey](symmetric-survey.md) records how each "
+              "submission implements its hashing and randomness.", ""]
+    (DEST / "index.md").write_text("\n".join(index), encoding="utf-8")
+    print(f"sync-performance: {len(site_of) + 1} pages for {len(systems)} system(s) -> "
+          f"{DEST.relative_to(ROOT)}/")
+
+
+if __name__ == "__main__":
+    main()
